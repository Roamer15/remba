# ---------------------------------------------------------------------------
# Remba environment configuration
# Copy this file to `.env` and fill in real values. Never commit your `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Local dev example:  postgresql://user:password@localhost:5432/remba?schema=public
# Production (Supabase): use the SESSION POOLER URL (host *.pooler.supabase.com, port 5432)
DATABASE_URL=

# OpenAI API key — powers the tool-using agent and onboarding/report generation.
OPENAI_API_KEY=

# --- WhatsApp Cloud API (Meta) ---
# Base Graph API URL, e.g. https://graph.facebook.com/v21.0
FACEBOOK_ENTRY_URL=
# The phone number ID of your WhatsApp Business number.
WHATSAPP_PHONE_NUMBER_ID=
# Permanent/long-lived access token for the WhatsApp Business account.
WHATSAPP_API_TOKEN=
# Token you choose; must match the value entered in the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=
# App secret used to verify webhook signatures (optional; reserved for future use).
WHATSAPP_APP_SECRET=

# --- Runtime ---
# Port the server listens on (defaults to 3000 if unset).
PORT=3000
# Public base URL of the deployed app, used by the keep-warm self-ping cron.
PRODUCTION_URL=
